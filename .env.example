# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=500
GROQ_TEMPERATURE=0.3

# Webhook Configuration (for deployment)
WEBHOOK_URL=https://your-app-url.com/webhook

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Optional: Logging Level
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
# For Railway: DATABASE_URL is auto-injected when PostgreSQL service is linked
# For local development: use individual variables below
DATABASE_URL=

# Local development fallback (used if DATABASE_URL is not set)


